<Div id="root">
    <Scroll>
        <Col>
            <Col>
                <Center>
                    <Label classes="title">Settings</Label>
                </Center>
                <Center classes="subtitle">Folder-specific settings</Center>
            </Col>

            <Space classes="default-space-size" />
            <Div classes="hr">
                <Void />
            </Div>
            <Space classes="default-space-size" />

            <Label classes="style-italic">All these settings require restarting the app!</Label>
            <Scroll>
                <Col id="folders-settings"></Col>
            </Scroll>

            <Col classes="single-settings" id="mcp-settings">
                <Label classes="set-sub">MCP Settings</Label>
                <Col classes="subsettings">
                    <Label classes="subset-sub">MCP</Label>
                    <Row>
                        <Label classes="set-label">Listen address</Label>
                        <Input classes="input" id="mcp-listen-addr-settings" placeholder="Example: localhost:8080"></Input>
                    </Row>
                </Col>
            </Col>

            <Col classes="single-settings" id="ai-settings">
                <Label>AI Settings</Label>
                <Col classes="subsettings">
                    <Label>Agent</Label>
                    <Row>
                        <Label>LLM Provider (Empty => don't change anything)</Label>
                        <Select id="llm-provider-settings" placeholder="Select an LLM provider">
                            <Option value="ollama">Ollama</Option>
                            <Option value="openai">OpenAI</Option>
                        </Select>
                    </Row>
                    <Row>
                        <Label>API Key (leave empty for none)</Label>
                        <Input id="api-key-settings" placeholder="Enter the provider's API key"></Input>
                    </Row>
                    <Row>
                        <Label>Chat model</Label>
                        <Input id="ai-model-settings" placeholder="Enter a model"></Input>
                    </Row>
                    <Row>
                        <Label>Allow thinking (only on Ollama)</Label>
                        <Checkbox id="thinking-settings">Check to allow thinking</Checkbox>
                    </Row>
                    <Row>
                        <Label>System prompt</Label>
                        <Textarea id="system-prompt-settings" placeholder="Enter a model"></Textarea>
                    </Row>
                </Col>

                <Col classes="subsettings">
                    <Label>RAG</Label>
                    <Row>
                        <Label>Embedding model</Label>
                        <Input id="rag-model-settings"
                            placeholder="The model that will create the RAG"></Input>
                    </Row>
                    <Row>
                        <Label>[Advanced] Top results</Label>
                        <Input id="rag-top-results-settings"
                            placeholder="Top results to give to the LLM"></Input>
                    </Row>
                    <Row>
                        <Label>[Advanced] Max batch size</Label>
                        <Input id="batch-size-settings"
                            placeholder="Cuts the file in smaller parts, unit: character"></Input>
                    </Row>
                </Col>
            </Col>

            <Button id="save">Save settings</Button>
            <Label id="status"></Label>
        </Col>
    </Scroll>
</Div>
